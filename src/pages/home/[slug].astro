---
import BaseLayout from '../../layouts/BaseLayout.astro';
import posts from '../../data/posts.json';

export function getStaticPaths() {
  return posts.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}

const { post } = Astro.props;
---

<BaseLayout title={post.title} description={post.description} canonicalPath={`/home/${post.slug}`}>
  <article class="post">
    <header class="post-header"><h1>{post.title}</h1><time datetime={post.date}>{post.date}</time></header>
    <div class="article-content" set:html={post.content} />
  </article>
</BaseLayout>
